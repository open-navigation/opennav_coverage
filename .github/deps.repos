# Versions the lyrical CI is tested against (the Lyrical binaries rosdep installs).
repositories:
  Fields2Cover:
    type: git
    url: https://github.com/Fields2Cover/Fields2Cover.git
    version: v2.1.1

  # nav2's lyrical branch: main has moved on to newer Rolling-only APIs.
  navigation2:
    type: git
    url: https://github.com/ros-navigation/navigation2.git
    version: lyrical

  ortools_vendor:
    type: git
    url: https://github.com/Fields2Cover/ortools_vendor.git
    version: 9.9.1

  behaviortree_cpp:
    type: git
    url: https://github.com/BehaviorTree/BehaviorTree.CPP.git
    version: 4.10.0
