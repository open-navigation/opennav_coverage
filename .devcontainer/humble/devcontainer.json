{
  "name": "opennav_coverage (ROS 2 Humble + F2C v2 apt, Feature/umutc/fields2cover2 branch)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // DİKKAT: Bu devcontainer'ı açmadan önce host'ta şu branch'e geçin:
  //   git checkout Feature/umutc/fields2cover2
  // (fields2cover2-main DEĞİL — o branch nav2_ros_common/rolling hedefler.)

  // Repo'yu colcon workspace'in src/'i olarak bağla.
  // Böylece build/install/log dizinleri /ros_ws altında (container içinde) kalır,
  // repo'yu kirletmez ve host'a yazılmaz.
  "workspaceMount": "source=${localWorkspaceFolder},target=/ros_ws/src/opennav_coverage,type=bind",
  "workspaceFolder": "/ros_ws/src/opennav_coverage",
  "remoteUser": "ros",

  // RViz / GUI (Linux host) için X11 passthrough — gerekmezse zararsız.
  // İlk seferinde host'ta bir kez:  xhost +local:docker
  "runArgs": ["--network=host", "--ipc=host"],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],

  // ROS bağımlılıkları artık Dockerfile'da gömülü (cache'li layer) → postCreate'e gerek yok.
  // Container yeniden yaratılınca sıfır indirme, anında açılır.
  // Yeni bağımlılık gerekirse Dockerfile'daki nav2 apt satırına ekle + "Rebuild Container".

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
